app.post('/api/analyze-product', async (req, res) => {
  try {
    const { productImage, category, wardrobeItems, userId } = req.body

    if (!productImage || !category || !userId) {
      return res.status(400).json({ error: 'Missing required fields' })
    }

    // Prepare wardrobe summary for AI context
    const wardrobeSummary = {
      total: wardrobeItems.length,
      byCategory: {
        tops: wardrobeItems.filter(item => item.category === 'tops').length,
        bottoms: wardrobeItems.filter(item => item.category === 'bottoms').length,
        shoes: wardrobeItems.filter(item => item.category === 'shoes').length,
        outerwear: wardrobeItems.filter(item => item.category === 'outerwear').length,
        accessories: wardrobeItems.filter(item => item.category === 'accessories').length
      },
      colors: wardrobeItems.map(item => item.color).filter(Boolean)
    }

    // Construct AI prompt for product analysis
    const prompt = `You are an expert fashion analyst. A user is considering buying a new ${category} item and wants to know if it will fit their existing wardrobe.

THEIR CURRENT WARDROBE:
- Total items: ${wardrobeSummary.total}
- Tops: ${wardrobeSummary.byCategory.tops}
- Bottoms: ${wardrobeSummary.byCategory.bottoms}
- Shoes: ${wardrobeSummary.byCategory.shoes}
- Outerwear: ${wardrobeSummary.byCategory.outerwear}
- Accessories: ${wardrobeSummary.byCategory.accessories}
- Existing colors: ${wardrobeSummary.colors.join(', ') || 'not specified'}

PRODUCT BEING CONSIDERED:
- Category: ${category}
- Image: [See attached product photo]

Analyze this product and provide a detailed assessment in JSON format with the following structure:

{
  "overallScore": <number 0-100>,
  "verdict": "<Strong Buy / Good Addition / Consider Carefully / Skip>",
  "verdictReason": "<brief explanation>",
  "wardrobeCompatibility": <number 0-100>,
  "compatibilityReason": "<why it does/doesn't fit their wardrobe>",
  "newOutfitsCount": <number>,
  "predictedWears": <number per month>,
  "wearFrequencyReason": "<explanation of wear prediction>",
  "colorImpact": "<Enhances / Neutral / Conflicts>",
  "colorImpactReason": "<how it affects their color palette>",
  "styleDNAMatch": <number 0-100>,
  "styleDNAReason": "<how well it matches their style>",
  "styleKeywords": ["<keyword1>", "<keyword2>", ...],
  "outfitSuggestions": [
    {
      "occasion": "<occasion type>",
      "description": "<outfit description>",
      "items": ["<item1>", "<item2>", ...]
    }
  ],
  "recommendation": "<buy / maybe / skip>",
  "recommendationReason": "<detailed reasoning>",
  "alternatives": ["<alternative suggestion 1>", "<alternative 2>", ...]
}

Be specific, practical, and honest. Consider versatility, styling potential, and whether this is actually a needed addition.`

    // Call Claude AI API
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': process.env.ANTHROPIC_API_KEY,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-3-5-sonnet-20241022',
        max_tokens: 2000,
        messages: [
          {
            role: 'user',
            content: [
              {
                type: 'image',
                source: {
                  type: 'base64',
                  media_type: productImage.split(';')[0].split(':')[1],
                  data: productImage.split(',')[1]
                }
              },
              {
                type: 'text',
                text: prompt
              }
            ]
          }
        ]
      })
    })

    if (!response.ok) {
      const errorData = await response.json()
      console.error('Claude API error:', errorData)
      throw new Error('AI analysis failed')
    }

    const data = await response.json()
    const aiResponse = data.content[0].text

    // Parse JSON response
    let analysis
    try {
      // Extract JSON from response (in case there's markdown formatting)
      const jsonMatch = aiResponse.match(/\{[\s\S]*\}/)
      if (jsonMatch) {
        analysis = JSON.parse(jsonMatch[0])
      } else {
        analysis = JSON.parse(aiResponse)
      }
    } catch (parseError) {
      console.error('JSON parse error:', parseError)
      console.error('AI response:', aiResponse)
      throw new Error('Failed to parse AI response')
    }

    // Validate and ensure all fields are present
    const validatedAnalysis = {
      overallScore: analysis.overallScore || 50,
      verdict: analysis.verdict || 'Consider Carefully',
      verdictReason: analysis.verdictReason || 'Analysis unavailable',
      wardrobeCompatibility: analysis.wardrobeCompatibility || 50,
      compatibilityReason: analysis.compatibilityReason || '',
      newOutfitsCount: analysis.newOutfitsCount || 0,
      predictedWears: analysis.predictedWears || 0,
      wearFrequencyReason: analysis.wearFrequencyReason || '',
      colorImpact: analysis.colorImpact || 'Neutral',
      colorImpactReason: analysis.colorImpactReason || '',
      styleDNAMatch: analysis.styleDNAMatch || 50,
      styleDNAReason: analysis.styleDNAReason || '',
      styleKeywords: analysis.styleKeywords || [],
      outfitSuggestions: analysis.outfitSuggestions || [],
      recommendation: analysis.recommendation || 'maybe',
      recommendationReason: analysis.recommendationReason || '',
      alternatives: analysis.alternatives || []
    }

    // Log analysis for user
    await supabase
      .from('closet_simulator_logs')
      .insert({
        user_id: userId,
        category: category,
        analysis: validatedAnalysis,
        created_at: new Date().toISOString()
      })

    res.json(validatedAnalysis)

  } catch (error) {
    console.error('Product analysis error:', error)
    res.status(500).json({ 
      error: 'Failed to analyze product',
      details: error.message 
    })
  }
})